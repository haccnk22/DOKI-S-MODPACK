{
  "version": 2,
  "nodeVersion": "22.x",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/vendor/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
